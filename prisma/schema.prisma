generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String   @unique
  password  String
  role      String   @default("USER") // ADMIN or USER
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wikiDirectories   WikiDirectory[]
  wikiArticles      WikiArticle[]
  wikiShareLinks    WikiShareLink[]
  wikiCollaborators WikiCollaborator[]
  posts             Post[]
  comments          Comment[]
  boardPermissions  BoardPermission[]
}

model Board {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts            Post[]
  boardPermissions BoardPermission[]
}

model BoardPermission {
  id      String @id @default(uuid()) @db.Uuid
  boardId String @db.Uuid
  userId  String @db.Uuid
  role    String @default("MEMBER") // MEMBER or MODERATOR

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
}

model WikiDirectory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  parentId  String?  @db.Uuid
  name      String
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent        WikiDirectory? @relation("DirectoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children      WikiDirectory[] @relation("DirectoryTree")
  wikiArticles  WikiArticle[]

  @@unique([userId, parentId, slug])
}

model WikiArticle {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  directoryId String?  @db.Uuid
  title       String
  content     String   @default("")
  slug        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  directory     WikiDirectory?     @relation(fields: [directoryId], references: [id], onDelete: SetNull)
  posts         Post[]
  shareItems    WikiShareItem[]
  collaborators WikiCollaborator[]

  @@unique([userId, directoryId, slug])
}

model WikiCollaborator {
  id        String   @id @default(uuid()) @db.Uuid
  articleId String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  article WikiArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([articleId, userId])
  @@index([userId])
}

model WikiShareLink {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  title     String?
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WikiShareItem[]

  @@index([userId])
}

model WikiShareItem {
  id          String   @id @default(uuid()) @db.Uuid
  shareLinkId String   @db.Uuid
  articleId   String   @db.Uuid
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  shareLink WikiShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
  article   WikiArticle   @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([shareLinkId, articleId])
  @@index([articleId])
  @@index([shareLinkId, sortOrder])
}

model Post {
  id         String   @id @default(uuid()) @db.Uuid
  boardId    String   @db.Uuid
  userId     String   @db.Uuid
  title      String
  content    String   @default("")
  sourceType String?  // DIRECTORY or ARTICLE (optional for normal posts)
  sourceId   String?  @db.Uuid
  syncEnabled Boolean @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  board       Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceArticle WikiArticle? @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  comments    Comment[]
}

model Comment {
  id      String   @id @default(uuid()) @db.Uuid
  postId  String   @db.Uuid
  userId  String   @db.Uuid
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SystemConfig {
  key    String @id
  value  String
}
